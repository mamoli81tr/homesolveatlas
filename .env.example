# Copy this file to .env.local (local dev) or set these in your hosting
# platform's dashboard (production). Nothing here is required for
# `npm run dev` — the site works with every value empty; features that
# depend on a variable simply stay off, and production metadata falls back
# safely to https://homesolveatlas.com even if NEXT_PUBLIC_SITE_URL is unset
# (see config/site.ts).

# --- Site identity -----------------------------------------------------
# Absolute production origin, no trailing slash, no /www/. Used to build
# canonical URLs, Open Graph tags, JSON-LD, sitemap.xml, and rss.xml.
NEXT_PUBLIC_SITE_URL=https://homesolveatlas.com

# Real, monitored inbox for the Contact page and the mailto: contact form.
# Leave empty until one exists — the Contact page and legal pages detect the
# empty value and show an honest "not yet available" state instead of a
# fake or broken address. See config/site.ts (contactEmail) and
# components/ContactForm.tsx.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Search Console ------------------------------------------------------
# Google Search Console "HTML tag" verification value — paste ONLY the
# content="..." token, not the whole <meta> tag. Get it from Search Console
# → Settings → Ownership verification → HTML tag method, after adding
# https://homesolveatlas.com as a property. See README.md → "Google Search
# Console".
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (optional).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- IndexNow ------------------------------------------------------------
# IndexNow API key (Bing, and other IndexNow-participating search engines).
# Any random hex/UUID-style string works — search engines don't issue this,
# you generate it yourself. Server-side only: deliberately NOT prefixed with
# NEXT_PUBLIC_, so it's never bundled into client JS. Leave empty to keep
# IndexNow fully disabled — the key verification route and the submission
# scripts both no-op safely when unset. See README.md → "INDEXNOW / BING".
INDEXNOW_KEY=

# --- Analytics -------------------------------------------------------------
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX.
# Only loaded client-side after the visitor accepts the "Analytics" cookie
# category in the consent banner. See README.md → "Google Analytics".
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Advertising -------------------------------------------------------------
# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX.
#
# This ID now has TWO independent effects:
#  1. Real ad markup — only once config/ads.ts also has `enabled: true`, and
#     only after the visitor accepts the "Advertising" cookie category. See
#     config/ads.ts and README.md → "AdSense".
#  2. Google's certified CMP (Funding Choices) — loads as soon as this is
#     set, regardless of `enabled`. This is deliberate: Google supports
#     turning on consent collection ahead of ads actually serving, which is
#     exactly HomeSolveAtlas's situation while the AdSense site review is
#     pending. See components/layout/GoogleCmp.tsx and README.md →
#     "Google Consent Mode & Google's certified CMP".
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# The exact line(s) your ad network gives you for /ads.txt, e.g.:
# google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
# Leave empty until you have a real network account — see app/ads.txt/route.ts.
ADS_TXT_ENTRIES=

# Set to "1" to preview ad placement boxes in a production build/deploy
# without flipping config/ads.ts's `enabled` — normally, before AdSense is
# enabled, ad slots render nothing at all in production (only in `next dev`)
# so the site reads as finished content rather than an empty ad template.
# See shouldRenderAdPlaceholder() in config/ads.ts.
NEXT_PUBLIC_AD_DEBUG=
