# Copy this file to .env.local (local dev) or set these in your hosting
# platform's dashboard (production). Nothing here is required for
# `npm run dev` — the site works with every value empty; features that
# depend on a variable simply stay off, and production metadata falls back
# safely to https://homesolveatlas.com even if NEXT_PUBLIC_SITE_URL is unset
# (see config/site.ts).

# --- Site identity -----------------------------------------------------
# Absolute production origin, no trailing slash, no /www/. Used to build
# canonical URLs, Open Graph tags, JSON-LD, sitemap.xml, and rss.xml.
NEXT_PUBLIC_SITE_URL=https://homesolveatlas.com

# Real, monitored inbox for the Contact page and the mailto: contact form.
# Leave empty until one exists — the Contact page and legal pages detect the
# empty value and show an honest "not yet available" state instead of a
# fake or broken address. See config/site.ts (contactEmail) and
# components/ContactForm.tsx.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Search Console ------------------------------------------------------
# Google Search Console "HTML tag" verification value — paste ONLY the
# content="..." token, not the whole <meta> tag. Get it from Search Console
# → Settings → Ownership verification → HTML tag method, after adding
# https://homesolveatlas.com as a property. See README.md → "Google Search
# Console".
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (optional).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Analytics -------------------------------------------------------------
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX.
# Only loaded client-side after the visitor accepts the "Analytics" cookie
# category in the consent banner. See README.md → "Google Analytics".
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Advertising -------------------------------------------------------------
# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX.
# Only loaded client-side after the visitor accepts the "Advertising" cookie
# category, and only once config/ads.ts has `enabled: true`. See
# config/ads.ts and README.md → "AdSense".
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# The exact line(s) your ad network gives you for /ads.txt, e.g.:
# google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
# Leave empty until you have a real network account — see app/ads.txt/route.ts.
ADS_TXT_ENTRIES=
